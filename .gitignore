public/
resources/_gen/

# Exported content. Everything under content/ is generated from the
# Obsidian vault by scripts/export-hugo.ts. The vault is the single
# source of truth for all content — nothing in this directory should
# ever be committed or hand-edited.
content/

# Generated reference-name index. Written by scripts/export-hugo.ts over every
# vault note so the theme can name a reference whose target has no page of its
# own. Derived from the vault, like content/ — never hand-edited or committed.
data/refnames.yaml

